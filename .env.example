# Supabase. Імена змінних читає @nuxtjs/supabase.
#
# Локальна розробка: значення видає `npx supabase start`.
# Cloudflare Pages: ті самі імена в змінних оточення білду — статична збірка
# вшиває їх у бандл на етапі `npm run generate`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-local-anon-key

# service_role-ключ у фронтенді НЕ використовується і сюди не додається.
# Уся підвищена логіка живе в SECURITY DEFINER-функціях бази (PRD §4.9).
