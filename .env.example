# Supabase. Імена змінних читає @nuxtjs/supabase.
#
# Хмарний проєкт: Dashboard → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon / publishable key>

# Локальна розробка: значення видає `npm run db:start`.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_KEY=<anon key з виводу supabase start>

# service_role-ключ у фронтенді НЕ використовується і сюди не додається.
# Уся підвищена логіка живе в SECURITY DEFINER-функціях бази (PRD §4.9).

# Google OAuth для ЛОКАЛЬНОГО стека — config.toml читає ці змінні.
# У хмарному проєкті ті самі значення вводяться в Dashboard →
# Authentication → Providers → Google, а не тут.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
